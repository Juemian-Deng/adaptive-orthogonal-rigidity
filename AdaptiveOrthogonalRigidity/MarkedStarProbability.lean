import AdaptiveOrthogonalRigidity.MarkedStarRelation
import AdaptiveOrthogonalRigidity.MonicAnnihilator
import AdaptiveOrthogonalRigidity.PolynomialSeedFibers

open MeasureTheory Matrix Polynomial
open scoped BigOperators Classical

namespace AdaptiveOrthogonalRigidity

local instance : Fact (Nat.Prime 3) := ⟨by decide⟩

abbrev MarkPolynomialPair (d : ℕ) :=
  Σ a : (Finset.Icc 1 d), MonicF3Degree a.val × MonicF3Degree (a.val - 1)

theorem markPolynomialPair_card (d : ℕ) : Fintype.card (MarkPolynomialPair d) = markPairCount d := by
  rw [Fintype.card_sigma]
  simp only [Fintype.card_prod, monicF3Degree_card, ← pow_add]
  have hexp (a : (Finset.Icc 1 d)) : a.val + (a.val - 1) = 2 * a.val - 1 := by
    have := (Finset.mem_Icc.mp a.property).1
    omega
  simp_rw [hexp]
  exact Finset.sum_attach _ (fun a => 3 ^ (2 * a - 1))

noncomputable def markedStarFailure {ι : Type*} [Fintype ι] (d : ℕ)
    (A : Matrix ι ι (ZMod 3)) (v : ι → ZMod 3) (a : ZMod 3) : Set (ι → Bool) :=
  {x | ∃ q : Polynomial (ZMod 3), q ≠ 0 ∧ q.natDegree ≤ d ∧
    (Polynomial.aeval (symmetricBorderMap A (boolVector x) a) q) (v, 1) = 0}

/-- The dependent lower coefficients generated by the star recurrence are
covered by all prescribed monic pairs. No conditioning on those coefficients occurs. -/
theorem marked_star_probability_bound {ι : Type*} [Fintype ι] [DecidableEq ι]
    (d h : ℕ) (A : Matrix ι ι (ZMod 3)) (v : ι → ZMod 3) (a : ZMod 3)
    (hgood : ∀ q : Polynomial (ZMod 3), q ≠ 0 → q.natDegree ≤ d →
      Module.finrank (ZMod 3) (Polynomial.aeval A q).mulVecLin.ker ≤ h)
    {α : ℝ} (hα : 0 ≤ α) (hαhalf : α ≤ 1 / 2)
    (p : ι → unitInterval) (hp : ∀ i, α ≤ (p i : ℝ) ∧ (p i : ℝ) ≤ 1 - α) :
    (cubeMeasure p).real (markedStarFailure d A v a) ≤
      (markPairCount d : ℝ) * (beta α) ^ ((Fintype.card ι : ℝ) - h) := by
  let E (gf : MarkPolynomialPair d) : Set (ι → Bool) :=
    {x | (Polynomial.aeval A gf.2.1.val).mulVec v +
      (Polynomial.aeval A gf.2.2.val).mulVec (boolVector x) = 0}
  have hsub : markedStarFailure d A v a ⊆ ⋃ gf, E gf := by
    rintro x ⟨q, hq, hd, hz⟩
    obtain ⟨g, hg, hgd, hgpos, hgz⟩ := exists_monic_annihilator
      (symmetricBorderMap A (boolVector x) a) (v, 1) (by
        intro h; have := congrArg Prod.snd h; exact one_ne_zero this) q hq hz
    obtain ⟨f, hf, hfd, heq⟩ := marked_star_equation A.mulVecLin
      (symmetricBorderMap A (boolVector x) a) (boolVector x) (fun _ => rfl) (v, 1) rfl g hg hgpos hgz
    let gf : MarkPolynomialPair d :=
      ⟨⟨g.natDegree, Finset.mem_Icc.mpr ⟨hgpos, hgd.trans_le hd⟩⟩,
        ⟨g, hg, rfl⟩, ⟨f, hf, hfd⟩⟩
    refine Set.mem_iUnion.mpr ⟨gf, ?_⟩
    change (Polynomial.aeval A g).mulVec v + (Polynomial.aeval A f).mulVec (boolVector x) = 0
    simpa only [← matrix_mulVecLin_aeval, Matrix.mulVecLin_apply] using heq
  have hE (gf : MarkPolynomialPair d) : (cubeMeasure p).real (E gf) ≤
      (beta α) ^ ((Fintype.card ι : ℝ) - h) := by
    have hfdeg : gf.2.2.val.natDegree ≤ d := by
      rw [gf.2.2.property.2]
      exact (Nat.sub_le _ _).trans (Finset.mem_Icc.mp gf.1.property).2
    have hsub' : E gf ⊆ {x | (Polynomial.aeval A gf.2.2.val).mulVec (boolVector x) =
        -(Polynomial.aeval A gf.2.1.val).mulVec v} := by
      intro x hx
      exact eq_neg_of_add_eq_zero_right hx
    exact (measureReal_mono hsub').trans (matrix_fiber_bound_of_nullity_le hα hαhalf p hp
      (Polynomial.aeval A gf.2.2.val) h (hgood _ gf.2.2.property.1.ne_zero hfdeg) _)
  calc
    _ ≤ (cubeMeasure p).real (⋃ gf, E gf) := measureReal_mono hsub
    _ ≤ ∑ gf, (cubeMeasure p).real (E gf) := measureReal_iUnion_fintype_le _
    _ ≤ ∑ _gf : MarkPolynomialPair d, (beta α) ^ ((Fintype.card ι : ℝ) - h) :=
      Finset.sum_le_sum (fun gf _ => hE gf)
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, markPolynomialPair_card, nsmul_eq_mul]

end AdaptiveOrthogonalRigidity
